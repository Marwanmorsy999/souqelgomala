# ============================================
# Souk El Gomla — Environment Variables (Cloudflare-first)
# ============================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# --- App (public, safe for the client bundle) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Souk El Gomla
NEXT_PUBLIC_APP_LOCALE=ar-EG
NEXT_PUBLIC_APP_CURRENCY=EGP

# --- Cloudflare Turnstile ---
# Site key is public (rendered in the browser).
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-site-key
# Secret is server-only. In production set as a Worker secret:
#   wrangler secret put CLOUDFLARE_TURNSTILE_SECRET_KEY
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-secret-key

# --- Application secret (server-only) ---
# Session/token derivation secret. Strongly random (e.g. `openssl rand -hex 32`).
# In production:  wrangler secret put SESSION_SECRET
SESSION_SECRET=

# --- Cloudflare D1 + Drizzle tooling (dev machine only) ---
# Used by `drizzle-kit` (see drizzle.config.ts). NOT bundled to the client.
# In production the D1/KV/R2/Queue bindings are provided by wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# --- Cloudflare bindings (production) ---
# These are NOT environment variables — they are declared as bindings in
# wrangler.jsonc and injected at runtime by the Workers runtime:
#   DB                  → D1 database
#   CACHE               → KV namespace
#   PRODUCTS_BUCKET, CATEGORIES_BUCKET, OFFERS_BUCKET,
#   PROFILES_BUCKET, BRANCHES_BUCKET → R2 buckets
#   ORDER_QUEUE, NOTIFICATION_QUEUE  → Queues
#   TURNSTILE_SECRET_KEY            → Turnstile secret (wrangler secret)
#   SESSION_SECRET                  → App secret (wrangler secret)

# --- Local development ---
# Run migrations against local D1 with:
#   wrangler d1 migrations apply DB --local
# Seed the first OWNER with:
#   SEED_ADMIN_EMAIL=owner@example.com SEED_ADMIN_PASSWORD=... pnpm seed:admin

